# Open Semrush Server Configuration
PORT=3000
NODE_ENV=production

# AI Engine (Gemini / OpenRouter) for "✨ Fix with AI" and "⚡ Outrank Strategy"
# Get an API key from Google AI Studio (https://aistudio.google.com/) or OpenRouter (https://openrouter.ai/)
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional Google Search Console integration; OAuth needs the webmasters.readonly scope
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_SEARCH_CONSOLE_ACCESS_TOKEN=
GOOGLE_SEARCH_CONSOLE_SITE_URL=sc-domain:example.com
