# Open Semrush Server Configuration
PORT=3000
NODE_ENV=production

# Protect expensive/API-sensitive routes (audit, AI suggestions, Search Console).
# Generate with: openssl rand -hex 32
# Required when exposing the service in production; send Authorization: Bearer <token>.
OPEN_SEMRUSH_API_TOKEN=

# Per-client in-memory limits. Use a trusted reverse proxy and network-level limits for public deployments.
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_EXPENSIVE_MAX=10

# Local JSON persistence. Mount a durable volume and back it up externally.
OPEN_SEMRUSH_DATA_DIR=./data
OPEN_SEMRUSH_MAX_HISTORY=50000

# AI Engine (Gemini / OpenRouter), optional.
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional Google Search Console integration; OAuth needs webmasters.readonly scope.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_SEARCH_CONSOLE_ACCESS_TOKEN=
GOOGLE_SEARCH_CONSOLE_SITE_URL=sc-domain:example.com
