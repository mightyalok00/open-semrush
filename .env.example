# Open Semrush Server Configuration
PORT=3000
NODE_ENV=development
# Compose publishes only on loopback by default; use 0.0.0.0 only behind suitable network controls.
HOST_BIND_ADDRESS=127.0.0.1

# Protect expensive/API-sensitive routes (audit, AI suggestions, Search Console).
# Generate with: openssl rand -hex 32
# Required when exposing the service in production; send Authorization: Bearer <token>.
# Supports a single token or comma-separated tokens (or OPEN_SEMRUSH_API_TOKENS) for zero-downtime secret rotation.
OPEN_SEMRUSH_API_TOKEN=
OPEN_SEMRUSH_API_TOKENS=

# Number of trusted reverse proxy hops (e.g. 1 behind Nginx/Cloudflare) to parse X-Forwarded-For safely.
# Defaults to 0 (uses socket remote address only).
TRUST_PROXY_HOPS=0

# Per-client in-memory limits. Use a trusted reverse proxy and network-level limits for public deployments.
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_EXPENSIVE_MAX=10

# Local JSON persistence. Mount a durable volume and back it up externally.
OPEN_SEMRUSH_DATA_DIR=./data
OPEN_SEMRUSH_MAX_HISTORY=50000

# AI Engine (Gemini / OpenRouter cascade), optional.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional preferred OpenRouter model (defaults to free model cascade: minimax, gemma-4, lfm, nemotron)
OPENROUTER_MODEL=

# Optional Google Search Console integration; OAuth needs webmasters.readonly scope.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_SEARCH_CONSOLE_ACCESS_TOKEN=
GOOGLE_SEARCH_CONSOLE_SITE_URL=sc-domain:example.com
