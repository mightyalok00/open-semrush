{
  "name": "open-semrush",
  "version": "1.0.0",
  "description": "Self-hosted technical SEO audit prototype with optional first-party Google Search Console reporting and explicitly modeled fallback metrics.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "open-semrush": "scripts/semrush.mjs",
    "open-semrush-server": "scripts/semrush-server.mjs"
  },
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node scripts/semrush-server.mjs",
    "dev": "npm run build && node scripts/semrush-server.mjs",
    "cli": "node scripts/semrush.mjs",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "test": "npm run build && node --no-warnings=ExperimentalWarning --test",
    "test:coverage": "npm run build && node --no-warnings=ExperimentalWarning --experimental-test-coverage --test",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "benchmark:load": "node scripts/load-benchmark.mjs",
    "benchmark:crawl": "npm run build && node scripts/crawl-benchmark.mjs",
    "benchmark:crawl:real": "npm run build && node scripts/crawl-benchmark.mjs --mode real --iterations 20 --concurrency 4",
    "benchmark:crawl:matrix": "npm run build && node scripts/crawl-benchmark.mjs --matrix",
    "check:security": "npm run build && node --no-warnings=ExperimentalWarning --test tests/security-regression.test.mjs",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "keywords": [
    "seo",
    "semrush",
    "ahrefs",
    "keyword-research",
    "site-audit",
    "backlinks",
    "serp-analysis",
    "competitor-analysis",
    "google-ranking",
    "open-source",
    "ai-seo"
  ],
  "author": "mightyalok00",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mightyalok00/open-semrush.git"
  },
  "bugs": {
    "url": "https://github.com/mightyalok00/open-semrush/issues"
  },
  "homepage": "https://github.com/mightyalok00/open-semrush#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
